{
  "name": "frontpile",
  "version": "0.1.2",
  "description": "Developer-focused, production-ready React component library.",
  "packageManager": "pnpm@10.2.1",
  "engines": {
    "node": ">=22.1.0"
  },
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc --skipLibCheck --noEmit",
    "build:package": "tsx scripts/build-package.ts",
    "build:all": "tsx scripts/build-all-packages.ts",
    "test": "jest",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "format:fix:docs": "prettier --write ./docs --plugin=prettier-plugin-tailwindcss",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "react",
    "component",
    "library",
    "frontpile"
  ],
  "author": "Fullpile",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@storybook/addon-webpack5-compiler-swc": "^3.0.0",
    "@storybook/react": "^9.0.4",
    "@storybook/react-webpack5": "^9.0.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jest": "^28.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "^9.0.4",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rollup": "^4.41.1",
    "rollup-plugin-dts": "^6.2.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "rollup-plugin-sizes": "^1.1.0",
    "storybook": "^9.0.4",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1"
  }
}
